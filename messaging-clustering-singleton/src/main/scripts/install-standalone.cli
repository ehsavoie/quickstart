## Batch file to configure the standalone server for the messaging-clustering-singleton quickstart.

batch

# -- Enable clustering, and set a cluster password
/subsystem=messaging-activemq/server=default:write-attribute(name=cluster-password, value=password)
/subsystem=messaging-activemq/server=default/jgroups-broadcast-group=bg-group1:add(jgroups-cluster=activemq-cluster, connectors=[http-connector])
/subsystem=messaging-activemq/server=default/jgroups-discovery-group=dg-group1:add(jgroups-cluster=activemq-cluster)
/subsystem=messaging-activemq/server=default/cluster-connection=my-cluster:add(connector-name=http-connector, discovery-group=dg-group1, cluster-connection-address=jms)
/subsystem=messaging-activemq/server=default/connection-factory=RemoteConnectionFactory:write-attribute(name=ha, value=true)

# -- Add mdb-delivery-group named "my-mdb-delivery-group"
/subsystem=ejb3/mdb-delivery-group=my-mdb-delivery-group:add(active=true)

# -- Run this batch file
run-batch

# Reload the server
reload
